# Plantilla de .env.prod para docker-compose.prod.yml (staging y producción).
# cp .env.prod.example .env.prod && chmod 600 .env.prod   — .env.prod NUNCA se versiona.
# Use contraseñas solo con [A-Za-z0-9] (van dentro de URLs postgres://): openssl rand -hex 24
# Uso: docker compose --env-file .env.prod -f docker-compose.prod.yml <comando>

# ---------- Despliegue ----------
# staging | prod (banners/logs)
APP_ENV=prod
# nombre público; también APP_BASE_URL=https://$DOMAIN
DOMAIN=crm.example.com
# o el espejo de Alibaba ACR
REGISTRY=ghcr.io/whoismanib
# lo actualiza scripts/deploy.sh en cada despliegue
IMAGE_TAG=v0.1.0
HTTP_PORT=80
HTTPS_PORT=443
# debe contener fullchain.pem y privkey.pem
TLS_CERT_DIR=/etc/ssl/crm
# webroot para certbot (http-01)
ACME_WEBROOT=/var/www/acme

# ---------- Base de datos ----------
POSTGRES_DB=wcrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser
DB_OWNER_USER=wcrm_owner
DB_OWNER_PASSWORD=CHANGE_ME_owner
DB_APP_USER=wcrm_app
DB_APP_PASSWORD=CHANGE_ME_app
DB_POOL_MAX=10

# ---------- Aplicación ----------
LOG_LEVEL=info
APP_TIMEZONE=America/Santiago
JOBS_TIMEZONE=America/Santiago
# 32 bytes en base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
# MFA_REQUIRED=true, COOKIE_SECURE=true y NODE_ENV=production están fijados en el compose (ADM-01).
SESSION_COOKIE_NAME=wc_sid
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_LOGIN_PER_MIN=5
LOGIN_MAX_FAILED=10
LOGIN_LOCK_MINUTES=15
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# ---------- Administrador inicial (lo crea el seed base solo si no existe) ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_initial_password

# ---------- Correo (SMTP real pendiente: hoy MAIL_DRIVER=console|none) ----------
MAIL_DRIVER=console
MAIL_FROM="CRM WhaleCloud LatAm <crm@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------- Respaldos (pg_dump diario cifrado → Alibaba OSS) ----------
BACKUP_TZ=America/Santiago
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=14
# guárdela también en la bóveda del equipo
BACKUP_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_48
BACKUP_S3_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
BACKUP_S3_REGION=oss-cn-hongkong
BACKUP_S3_BUCKET=CHANGE_ME_bucket
BACKUP_S3_PREFIX=backups/prod/
BACKUP_S3_ADDRESSING_STYLE=virtual
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME_ram_access_key_id
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME_ram_access_key_secret
