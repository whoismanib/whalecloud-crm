{
  "name": "@wcrm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/db/seed/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.1",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@node-rs/argon2": "2.0.2",
    "@wcrm/shared": "*",
    "decimal.js": "10.4.3",
    "drizzle-orm": "0.38.3",
    "exceljs": "4.4.0",
    "fastify": "5.2.0",
    "otplib": "12.0.1",
    "pg": "8.13.1",
    "pg-boss": "10.1.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "drizzle-kit": "0.30.1",
    "supertest": "7.0.0",
    "tsup": "8.3.5",
    "tsx": "4.23.15"
  }
}
